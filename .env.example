# Public site URL for canonical links, Open Graph, and sitemap (no trailing slash)
# VITE_SITE_URL=https://goldcupaz.netlify.app

# Create a project at https://supabase.com — Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Admin MVP (injected at build via vite.config — also set ADMIN_PASSWORD on Netlify)
ADMIN_PASSWORD=goldcupadmin
# Supabase Auth user email; user password in Auth must match ADMIN_PASSWORD
VITE_ADMIN_EMAIL=admin@yourdomain.com
